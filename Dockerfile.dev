# ========================================
#  Filharmonia AI - Development Dockerfile
#  For docker-compose development setup
# ========================================

# Backend Development Stage
FROM python:3.11-slim AS backend-dev

WORKDIR /app/backend

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and filter out CUDA torch packages
COPY backend/requirements.txt .
RUN grep -v '^torch\|^torchaudio\|^torchvision' requirements.txt > requirements-docker.txt

# Install PyTorch with CUDA 12.1
RUN pip install --no-cache-dir \
    torch==2.5.1+cu121 torchaudio==2.5.1+cu121 torchvision==0.20.1+cu121 \
    --index-url https://download.pytorch.org/whl/cu121

# Install remaining dependencies
RUN pip install --no-cache-dir -r requirements-docker.txt

# Frontend Development Stage
FROM node:20-slim AS frontend-dev

WORKDIR /app/frontend

# Install pnpm
RUN npm install -g pnpm

# Copy package files
COPY frontend/package.json frontend/pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Default command will be overridden by docker-compose
CMD ["pnpm", "dev", "--host", "0.0.0.0"]
